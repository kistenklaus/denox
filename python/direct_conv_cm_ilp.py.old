import pandas as pd
from pathlib import Path
import numpy as np
import matplotlib.pyplot as plt

from pulp import (
    LpProblem,
    LpVariable,
    LpMinimize,
    lpSum,
    LpBinary,
    PULP_CBC_CMD,
    LpStatus,
    value,
)

# ============================================================
# parameters
# ============================================================
ALPHA = 0.95  # alpha set per group = configs with score >= ALPHA

# each group must keep at least this many alpha configs, if they exist
ALPHA_COVER_G = 5

# each group must keep at least this many fallback configs
FALLBACK_COVER_G = 5
# fallback set per group = top-K configs by score
FALLBACK_TOP_K = 10

CBC_TIME_LIMIT_SEC = None  # e.g. 60, or None
CBC_MSG = False

GROUP_COLS = [
    "operation",
    "device",
    "input_shape",
    "input_format",
    "input_type",
    "output_shape",
    "output_format",
    "output_type",
]

# logical operation = same op + same IO signature, but device-agnostic
LOGICAL_OP_COLS = [
    "operation",
    "input_shape",
    "input_format",
    "input_type",
    "output_shape",
    "output_format",
    "output_type",
]

SCORE_COL = "relative_speedup"

CONFIG_COLS = [
    "config_CM_M",
    "config_CM_K",
    "config_CM_N",
    "config_SG_M",
    "config_SG_K",
    "config_SG_N",
    "config_WG_M",
    "config_WG_N",
    "config_ASYNC",
]
CONFIG_COLS = [
    "config_INVOC_M",
    "config_INVOC_K",
    "config_INVOC_N",
    "config_SG_M",
    "config_SG_K",
    "config_SG_N",
    "config_WG_M",
    "config_WG_N",
    "config_ASYNC",
]

PARQUET_GLOB = "direct-conv*"
# DOES_NOT_START_WITH = None
DOES_NOT_START_WITH = "direct-conv-cm"

# devices used to BUILD the policy
POLICY_DEVICES = [
    "NVIDIA GeForce RTX 4070",
    "NVIDIA GeForce RTX 4080 SUPER",
    "Intel(R) Arc(tm) B580 Graphics (BMG G21)",
]
# POLICY_DEVICES = None

# devices used to EVALUATE the policy
EVAL_DEVICES = [
    "NVIDIA GeForce RTX 4070",
    "NVIDIA GeForce RTX 4080 SUPER",
    "Intel(R) Arc(tm) B580 Graphics (BMG G21)",
]
# EVAL_DEVICES = None


INPUT_SHAPE = None
# INPUT_SHAPE = "1088x1920x32"
# INPUT_SHAPE = "544x960x32"
# INPUT_SHAPE = "272x480x48"
# INPUT_SHAPE = "136x240x64"
# INPUT_SHAPE = "272x480x32"
# INPUT_SHAPE = "136x240x32"
# INPUT_SHAPE = "1088x1920x64"
# INPUT_SHAPE = "1088x1920x67"
# INPUT_SHAPE = "1088x1920x3"
# INPUT_SHAPE = "544x960x64"
# INPUT_SHAPE = "544x960x128"
# INPUT_SHAPE = "272x480x96"
# INPUT_SHAPE = "272x480x160"
# INPUT_SHAPE = "136x240x112"
# INPUT_SHAPE = "136x240x160"
# INPUT_SHAPE = "68x120x96"
# INPUT_SHAPE = "68x120x80"
# INPUT_SHAPE = "1088x1920x35"
# INPUT_SHAPE = "544x960x96"
# INPUT_SHAPE = "272x480x64"
# INPUT_SHAPE = "68x120x32"

BINS = 200


def make_topk(
    df: pd.DataFrame,
    group_cols: list[str],
    score_col: str,
    top_k: int,
) -> pd.DataFrame:
    df_sorted = df.sort_values(
        by=group_cols + [score_col],
        ascending=[True] * len(group_cols) + [False],
        kind="mergesort",
    )

    topk = (
        df_sorted.groupby(group_cols, group_keys=False, sort=False).head(top_k).copy()
    )

    topk["group_rank"] = (
        topk.groupby(group_cols)[score_col]
        .rank(method="first", ascending=False)
        .astype(int)
    )

    return topk


def make_alpha_eligible(
    df: pd.DataFrame,
    score_col: str,
    alpha: float,
) -> pd.DataFrame:
    return df.loc[df[score_col] >= alpha].copy()


def build_config_universe(
    df: pd.DataFrame,
    config_cols: list[str],
) -> pd.DataFrame:
    config_universe = (
        df[config_cols]
        .drop_duplicates()
        .sort_values(config_cols, kind="mergesort")
        .reset_index(drop=True)
    )
    config_universe["config_id"] = np.arange(len(config_universe), dtype=np.int32)
    return config_universe


def make_config_policy(
    config_universe: pd.DataFrame,
    surviving_configs: pd.DataFrame,
    config_cols: list[str],
) -> tuple[pd.DataFrame, np.ndarray, np.ndarray, np.ndarray]:
    surviving_configs_marked = surviving_configs[config_cols].drop_duplicates().copy()
    surviving_configs_marked["keep"] = True

    config_policy = config_universe.merge(
        surviving_configs_marked,
        on=config_cols,
        how="left",
    )
    config_policy["keep"] = config_policy["keep"].fillna(False).astype(bool)

    mask_bool = config_policy["keep"].to_numpy(dtype=bool)
    mask_u8 = mask_bool.astype(np.uint8)
    mask_packed = np.packbits(mask_u8, bitorder="little")

    return config_policy, mask_bool, mask_u8, mask_packed


def apply_config_policy(
    df: pd.DataFrame,
    config_policy: pd.DataFrame,
    config_cols: list[str],
) -> pd.DataFrame:
    return df.merge(
        config_policy.loc[config_policy["keep"], config_cols],
        on=config_cols,
        how="inner",
    )


def solve_hybrid_multicover(
    source_df: pd.DataFrame,
    fallback_df: pd.DataFrame,
    alpha_df: pd.DataFrame,
    group_cols: list[str],
    config_cols: list[str],
    fallback_cover_g: int,
    alpha_cover_g: int,
    time_limit_sec=None,
    msg: bool = False,
):
    # all groups that exist in the source dataset
    groups = (
        source_df[group_cols]
        .drop_duplicates()
        .sort_values(group_cols, kind="mergesort")
        .reset_index(drop=True)
    )
    groups["group_id"] = np.arange(len(groups), dtype=np.int32)

    # config universe relevant to the hybrid solver:
    # union of fallback configs and alpha configs
    candidate_configs = (
        pd.concat(
            [
                fallback_df[config_cols],
                alpha_df[config_cols],
            ],
            ignore_index=True,
        )
        .drop_duplicates()
        .sort_values(config_cols, kind="mergesort")
        .reset_index(drop=True)
    )
    candidate_configs["candidate_config_id"] = np.arange(
        len(candidate_configs), dtype=np.int32
    )

    if candidate_configs.empty:
        raise RuntimeError("No candidate configs found for hybrid solver.")

    # relations
    fallback_relation = (
        fallback_df[group_cols + config_cols]
        .drop_duplicates()
        .merge(groups, on=group_cols, how="inner")
        .merge(candidate_configs, on=config_cols, how="inner")[
            ["group_id", "candidate_config_id"]
        ]
        .drop_duplicates()
        .sort_values(["group_id", "candidate_config_id"], kind="mergesort")
        .reset_index(drop=True)
    )

    alpha_relation = (
        alpha_df[group_cols + config_cols]
        .drop_duplicates()
        .merge(groups, on=group_cols, how="inner")
        .merge(candidate_configs, on=config_cols, how="inner")[
            ["group_id", "candidate_config_id"]
        ]
        .drop_duplicates()
        .sort_values(["group_id", "candidate_config_id"], kind="mergesort")
        .reset_index(drop=True)
    )

    group_to_fallback = (
        fallback_relation.groupby("group_id")["candidate_config_id"]
        .apply(list)
        .to_dict()
    )
    group_to_alpha = (
        alpha_relation.groupby("group_id")["candidate_config_id"].apply(list).to_dict()
    )

    fallback_count_per_group = {
        g: len(group_to_fallback.get(g, [])) for g in groups["group_id"]
    }
    alpha_count_per_group = {
        g: len(group_to_alpha.get(g, [])) for g in groups["group_id"]
    }

    fallback_demand = {
        g: min(fallback_cover_g, fallback_count_per_group[g])
        for g in groups["group_id"]
    }
    alpha_demand = {
        g: min(alpha_cover_g, alpha_count_per_group[g]) for g in groups["group_id"]
    }

    num_zero_alpha_groups = sum(1 for n in alpha_count_per_group.values() if n == 0)
    print(f"\nGroups with zero alpha-eligible configs: {num_zero_alpha_groups}")

    prob = LpProblem("hybrid_alpha_fallback_multicover", LpMinimize)

    x = {
        c: LpVariable(f"x_{c}", cat=LpBinary)
        for c in candidate_configs["candidate_config_id"]
    }

    # minimize number of selected configs
    prob += lpSum(x[c] for c in candidate_configs["candidate_config_id"])

    # fallback constraints
    for g in groups["group_id"]:
        covered_by = group_to_fallback.get(g, [])
        d = fallback_demand[g]
        if d > 0:
            prob += lpSum(x[c] for c in covered_by) >= d, f"fallback_cover_group_{g}"

    # alpha constraints
    for g in groups["group_id"]:
        covered_by = group_to_alpha.get(g, [])
        d = alpha_demand[g]
        if d > 0:
            prob += lpSum(x[c] for c in covered_by) >= d, f"alpha_cover_group_{g}"

    solver_kwargs = {"msg": msg}
    if time_limit_sec is not None:
        solver_kwargs["timeLimit"] = time_limit_sec

    status = prob.solve(PULP_CBC_CMD(**solver_kwargs))
    objective = value(prob.objective)
    if objective is not None:
        objective = int(round(objective))

    selected_config_ids = [
        c
        for c in candidate_configs["candidate_config_id"]
        if x[c].value() is not None and x[c].value() > 0.5
    ]

    selected_configs = (
        candidate_configs.loc[
            candidate_configs["candidate_config_id"].isin(selected_config_ids),
            config_cols,
        ]
        .drop_duplicates()
        .sort_values(config_cols, kind="mergesort")
        .reset_index(drop=True)
    )

    return {
        "status": LpStatus[status],
        "objective": objective,
        "groups": groups,
        "candidate_configs": candidate_configs,
        "fallback_relation": fallback_relation,
        "alpha_relation": alpha_relation,
        "selected_configs": selected_configs,
        "fallback_demand": fallback_demand,
        "alpha_demand": alpha_demand,
        "fallback_count_per_group": fallback_count_per_group,
        "alpha_count_per_group": alpha_count_per_group,
    }


dfs: list[pd.DataFrame] = []
for path in Path("./parquets/").glob(PARQUET_GLOB):
    if DOES_NOT_START_WITH is not None and path.name.startswith(DOES_NOT_START_WITH):
        continue
    dfs.append(pd.read_parquet(path))

if not dfs:
    raise RuntimeError(f"No parquet files matched ./parquets/{PARQUET_GLOB}")

raw_df = pd.concat(dfs, ignore_index=True)

print("Devices:")
for device in sorted(raw_df["device"].dropna().unique()):
    print(f'"{device}"')

print("\nInput shapes:")
for input_shape in raw_df["input_shape"].dropna().unique():
    print(f'"{input_shape}"')

policy_df_source = raw_df.copy()

if POLICY_DEVICES is not None:
    policy_df_source = policy_df_source.loc[
        policy_df_source["device"].isin(POLICY_DEVICES)
    ].copy()

if policy_df_source.empty:
    raise RuntimeError("Policy construction dataframe is empty after filtering.")

eval_df = raw_df.copy()

if EVAL_DEVICES is not None:
    eval_df = eval_df.loc[eval_df["device"].isin(EVAL_DEVICES)].copy()

if INPUT_SHAPE is not None:
    eval_df = eval_df.loc[eval_df["input_shape"] == INPUT_SHAPE].copy()

if eval_df.empty:
    raise RuntimeError("Evaluation dataframe is empty after filtering.")

fallback_topk = make_topk(
    df=policy_df_source,
    group_cols=GROUP_COLS,
    score_col=SCORE_COL,
    top_k=FALLBACK_TOP_K,
)

alpha_eligible = make_alpha_eligible(
    df=policy_df_source,
    score_col=SCORE_COL,
    alpha=ALPHA,
)

topk_union_surviving_configs = (
    fallback_topk[CONFIG_COLS]
    .drop_duplicates()
    .sort_values(CONFIG_COLS, kind="mergesort")
    .reset_index(drop=True)
)

alpha_union_surviving_configs = (
    alpha_eligible[CONFIG_COLS]
    .drop_duplicates()
    .sort_values(CONFIG_COLS, kind="mergesort")
    .reset_index(drop=True)
)

# ============================================================
# hybrid set cover
# ============================================================
hybrid_result = solve_hybrid_multicover(
    source_df=policy_df_source,
    fallback_df=fallback_topk,
    alpha_df=alpha_eligible,
    group_cols=GROUP_COLS,
    config_cols=CONFIG_COLS,
    fallback_cover_g=FALLBACK_COVER_G,
    alpha_cover_g=ALPHA_COVER_G,
    time_limit_sec=CBC_TIME_LIMIT_SEC,
    msg=CBC_MSG,
)

print(f"\nHybrid solver status: {hybrid_result['status']}")
print(f"Hybrid objective (selected configs): {hybrid_result['objective']}")

hybrid_surviving_configs = hybrid_result["selected_configs"]

config_universe = build_config_universe(policy_df_source, CONFIG_COLS)

topk_config_policy, topk_mask_bool, topk_mask_u8, topk_mask_packed = make_config_policy(
    config_universe=config_universe,
    surviving_configs=topk_union_surviving_configs,
    config_cols=CONFIG_COLS,
)

(
    alpha_union_config_policy,
    alpha_union_mask_bool,
    alpha_union_mask_u8,
    alpha_union_mask_packed,
) = make_config_policy(
    config_universe=config_universe,
    surviving_configs=alpha_union_surviving_configs,
    config_cols=CONFIG_COLS,
)

hybrid_config_policy, hybrid_mask_bool, hybrid_mask_u8, hybrid_mask_packed = (
    make_config_policy(
        config_universe=config_universe,
        surviving_configs=hybrid_surviving_configs,
        config_cols=CONFIG_COLS,
    )
)

eval_topk_policy_df = apply_config_policy(eval_df, topk_config_policy, CONFIG_COLS)
eval_alpha_union_policy_df = apply_config_policy(
    eval_df, alpha_union_config_policy, CONFIG_COLS
)
eval_hybrid_policy_df = apply_config_policy(eval_df, hybrid_config_policy, CONFIG_COLS)

print(
    f"Search-Space : "
    f"{len(eval_df.index)} dispatches, "
    f"{eval_df.groupby(CONFIG_COLS).ngroups} unique configs, "
    f"max-used {eval_df.groupby(GROUP_COLS).size().max()}"
)
print(
    f"Top-K        : "
    f"{len(eval_topk_policy_df.index)} dispatches, "
    f"{eval_topk_policy_df.groupby(CONFIG_COLS).ngroups} unique configs, "
    f"max-used {eval_topk_policy_df.groupby(GROUP_COLS).size().max()}"
)
print(
    f"Set Cover    : "
    f"{len(eval_hybrid_policy_df.index)} dispatches, "
    f"{eval_hybrid_policy_df.groupby(CONFIG_COLS).ngroups} unique configs, "
    f"max-used {eval_hybrid_policy_df.groupby(GROUP_COLS).size().max()} "
)

x_full = eval_df[SCORE_COL].to_numpy()
x_topk_union = eval_topk_policy_df[SCORE_COL].to_numpy()
x_alpha_union = eval_alpha_union_policy_df[SCORE_COL].to_numpy()
x_hybrid = eval_hybrid_policy_df[SCORE_COL].to_numpy()

# print(eval_hybrid_policy_df)
# print(eval_df)

if (
    len(x_full) > 0
    and len(x_topk_union) > 0
    and len(x_alpha_union) > 0
    and len(x_hybrid) > 0
):
    min_v = min(x_full.min(), x_topk_union.min(), x_alpha_union.min(), x_hybrid.min())
    max_v = max(x_full.max(), x_topk_union.max(), x_alpha_union.max(), x_hybrid.max())
    bin_edges = np.linspace(min_v, max_v, BINS + 1)

    plt.figure(figsize=(10, 5))
    plt.hist(
        x_full,
        bins=bin_edges,
        alpha=0.35,
        label="full search space",
    )
    plt.hist(
        x_topk_union,
        bins=bin_edges,
        alpha=0.35,
        label="top-k",
    )
    plt.hist(
        x_hybrid,
        bins=bin_edges,
        alpha=0.35,
        label=("set-cover"),
    )
    plt.xlabel(SCORE_COL)
    plt.ylabel("number of configs")
    plt.legend()
    plt.tight_layout()
    plt.savefig("plot_direct_conv_cm_set_cover.pdf")
    plt.close()
else:
    print("NOPLOT")
